#!/bin/sh

LOG=/var/spool/hylafax/log/kaosgdd-faxmail-faxdispatch.log
ENV_FILE=/etc/kaosgdd/faxmail.env
SENDER_SCRIPT=/srv/projects/KaosGDD/ops/faxmail/send-incoming-fax-email.py

{
  echo "--- $(date -Is) FaxDispatch start ---"
  echo "FILE=$FILE"
  echo "DEVICE=$DEVICE"
  echo "COMMID=$COMMID"
  echo "MSG=$MSG"
  echo "CIDNUMBER=$CIDNUMBER"
  echo "SENDER=$SENDER"
} >> "$LOG" 2>&1

case "$FILE" in
  /*) SRC="$FILE" ;;
  *)  SRC="/var/spool/hylafax/$FILE" ;;
esac

echo "SRC=$SRC" >> "$LOG" 2>&1

if [ ! -f "$SRC" ]; then
  echo "skip: fax file missing: $SRC" >> "$LOG" 2>&1
  echo "--- $(date -Is) FaxDispatch end ---" >> "$LOG" 2>&1
  exit 0
fi

if [ -f "$ENV_FILE" ]; then
  # shellcheck disable=SC1090
  set -a
  . "$ENV_FILE"
  set +a
else
  echo "skip: missing $ENV_FILE" >> "$LOG" 2>&1
  echo "--- $(date -Is) FaxDispatch end ---" >> "$LOG" 2>&1
  exit 0
fi

REMOTE_NUMBER=${CIDNUMBER:-${SENDER:-unknown}}
[ -n "$REMOTE_NUMBER" ] || REMOTE_NUMBER=unknown
echo "REMOTE_NUMBER=$REMOTE_NUMBER" >> "$LOG" 2>&1

/usr/bin/python3 "$SENDER_SCRIPT" \
  "$SRC" \
  --remote-number "$REMOTE_NUMBER" \
  --device "${DEVICE:-ttyACM0}" \
  --commid "${COMMID:-}" >> "$LOG" 2>&1

echo "sender exit=$?" >> "$LOG" 2>&1
echo "--- $(date -Is) FaxDispatch end ---" >> "$LOG" 2>&1

# Prevent default faxrcvd from trying local Postfix/mail behavior.
exit 0
