[Unit]
Description=Retry failed KaosGDD incoming fax mailbox deliveries
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=uucp
Group=uucp
EnvironmentFile=/etc/kaosgdd/faxmail.env
ExecStart=/usr/bin/python3 /usr/local/lib/kaosgdd/faxmail/send-incoming-fax-email.py --retry-failures
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/spool/hylafax/status/kaosgdd-faxmail
