[Unit]
Description=Delete Telegram-archived incoming fax TIFFs after retention
After=kaos-hylafax-backup.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/kaosgdd/faxmail/cleanup-received-faxes.py --retention-days 30
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/spool/hylafax/recvq
ReadWritePaths=/srv/kaos/backups/faxmail
ReadOnlyPaths=/srv/kaos/data/kaosgdd/brain/faxmail/telegram-archive.json
